{
  "tabWidth": 2,
  "trailingComma": "es5",
  "singleQuote": true,
  "bracketSpacing": true,
  "semi": false,
  "printWidth": 100,
  "plugins": ["@trivago/prettier-plugin-sort-imports"],
  "importOrder": ["^react$", "^react", "<THIRD_PARTY_MODULES>", "^@", "^[./]"],
  "importOrderSeparation": true
}
